@page "/patrimoine"
@page "/patrimoine/{ClientId:guid}"

@inject Praxis360_v1.Services.SituationAssuranceVieService SituationService
@inject Praxis360_v1.Application.Interfaces.IClientSelectionService ClientSelectionService
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager

<PageTitle>Ma situation</PageTitle>

@if (_uiState == UiState.Loading)
{
	<div class="portfolio-container">
		<div class="portfolio-header">
			<h1>Ma situation</h1>
			<p class="portfolio-subtitle">Chargement de votre situation...</p>
		</div>
	</div>
}
else if (_uiState == UiState.NoClientsAvailable)
{
	<div class="portfolio-container">
		<div class="portfolio-header">
			<h1>Ma situation</h1>
			<p class="portfolio-subtitle">Bienvenue dans votre espace de gestion d'assurance vie.</p>
		</div>
		<section class="portfolio-section">
			<P360Card>
				<div class="empty-state">
					<p>Vous n'avez pas encore de clients enregistrés.</p>
					<p>Commencez par <a href="/imports/brio">importer vos données BRIO</a>.</p>
				</div>
			</P360Card>
		</section>
	</div>
}
else if (_uiState == UiState.MultipleClientsRequireSelection)
{
	<div class="portfolio-container">
		<div class="portfolio-header">
			<h1>Ma situation</h1>
			<p class="portfolio-subtitle">Veuillez sélectionner un client pour afficher sa situation.</p>
		</div>
		<section class="portfolio-section">
			<h2 class="section-title">Sélectionner un client</h2>
			<div class="client-selection-list">
				@if (_selectableClients != null)
				{
					@foreach (var client in _selectableClients)
					{
						<P360Card>
							<div class="selectable-client-card" @onclick="() => NavigateToClient(client.ClientId)">
								<div class="client-info">
									<span class="client-name">@client.DisplayName</span>
									@if (client.DateOfBirth.HasValue)
									{
										<span class="client-dob">Né(e) le @client.DateOfBirth.Value.ToString("dd/MM/yyyy")</span>
									}
								</div>
								<div class="chevron-icon">›</div>
							</div>
						</P360Card>
					}
				}
			</div>
		</section>
	</div>
}
else if (_uiState == UiState.ClientNotFound)
{
	<div class="portfolio-container">
		<div class="portfolio-header">
			<h1>Ma situation</h1>
			<p class="portfolio-subtitle">Client introuvable.</p>
		</div>
		<section class="portfolio-section">
			<P360Card>
				<div class="empty-state">
					<p>Le client demandé n'existe pas ou a été supprimé.</p>
					<p><a href="/patrimoine">Retour à la sélection</a></p>
				</div>
			</P360Card>
		</section>
	</div>
}
else if (_uiState == UiState.ErrorLoading)
{
	<div class="portfolio-container">
		<div class="portfolio-header">
			<h1>Ma situation</h1>
			<p class="portfolio-subtitle">Une erreur est survenue.</p>
		</div>
		<section class="portfolio-section">
			<P360Card>
				<div class="empty-state">
					<p>Impossible de charger la situation. Veuillez réessayer ultérieurement.</p>
				</div>
			</P360Card>
		</section>
	</div>
}
else if (_uiState == UiState.ClientLoaded && _situation != null)
{

<div class="portfolio-container">
	<div class="portfolio-header">
		<h1>Ma situation</h1>
		<p class="portfolio-subtitle">Comprenez votre situation en assurance vie en un coup d'œil.</p>
	</div>

	<section class="portfolio-section">
		<h2 class="section-title">Assurances vie</h2>

		<div class="indicators-grid">
			<P360Card>
				<div class="indicator-card">
					<div class="indicator-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
					<p class="indicator-label">Ma réserve acquise</p>
					<p class="indicator-value">@FormatMoney(_situation?.ReserveAcquise)</p>
				</div>
			</P360Card>

			<P360Card>
				<div class="indicator-card">
					<div class="indicator-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<circle cx="12" cy="12" r="10" stroke-width="2"/>
							<path d="M12 6v6l4 2" stroke-width="2" stroke-linecap="round"/>
						</svg>
					</div>
					<p class="indicator-label">Mon capital à terme</p>
					<p class="indicator-value">@FormatMoney(_situation?.CapitalATerme)</p>
				</div>
			</P360Card>

			<P360Card>
				<div class="indicator-card">
					<div class="indicator-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
					<p class="indicator-label">Mon capital décès</p>
					<p class="indicator-value">@FormatMoney(_situation?.CapitalDeces)</p>
				</div>
			</P360Card>

			<P360Card>
				<div class="indicator-card">
					<div class="indicator-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<path d="M19 12H5M12 5c-3 0-4 2-4 3.5C8 10 9 12 12 12s4-2 4-3.5C16 7 15 5 12 5zM12 12c-3 0-4 2-4 3.5S9 19 12 19s4-2 4-3.5S15 12 12 12z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
					<p class="indicator-label">Mon revenu garanti</p>
					<p class="indicator-value">@FormatMoney(_situation?.RevenuGaranti)</p>
				</div>
			</P360Card>
		</div>
	</section>

	<section class="portfolio-section">
		<h2 class="section-title">Mes contrats</h2>

		<div class="contracts-list">
			@if (_situation?.Contracts != null && _situation.Contracts.Any())
			{
				@foreach (var contract in _situation.Contracts)
				{
					<P360Card>
						<div class="contract-card">
							<div class="contract-main">
								<div class="contract-company-badge">
									@if (!string.IsNullOrWhiteSpace(contract.InsurerKey))
									{
										@contract.InsurerKey
									}
									else
									{
										<text>—</text>
									}
								</div>
								<div class="contract-info">
									<div class="contract-title-row">
										<span class="contract-type">@contract.ContractTypeLabel</span>
										<span class="contract-separator">—</span>
										<span class="contract-company">@contract.InsurerDisplayName</span>
									</div>
									<div class="contract-status-row">
										<span class="contract-status-badge @contract.StatusCssClass">
											@contract.StatusLabel
										</span>
									</div>
									@if (contract.GuaranteeLabels.Any())
									{
										<div class="contract-guarantees">
											@foreach (var guarantee in contract.GuaranteeLabels)
											{
												<span class="guarantee-badge">@guarantee</span>
											}
										</div>
									}
									<p class="contract-description">@contract.Description</p>
								</div>
							</div>
							<div class="contract-chevron">
								<span class="chevron-icon">›</span>
							</div>
						</div>
					</P360Card>
				}
			}
			else
			{
				<P360Card>
					<div class="contract-card">
						<p>Aucun contrat disponible</p>
					</div>
				</P360Card>
			}
		</div>
	</section>
</div>
}

@code {
	[Parameter]
	public Guid? ClientId { get; set; }

	private Praxis360_v1.Models.SituationAssuranceVieReadModel? _situation;
	private IReadOnlyCollection<Praxis360_v1.Application.Models.SelectableClient>? _selectableClients;
	private UiState _uiState = UiState.Loading;

	protected override async Task OnParametersSetAsync()
	{
		_uiState = UiState.Loading;
		_situation = null;
		_selectableClients = null;

		try
		{
			if (ClientId.HasValue)
			{
				// Route is /patrimoine/{ClientId:guid}
				_situation = await SituationService.GetSituationForClientAsync(ClientId.Value);

				if (_situation != null)
				{
					_uiState = UiState.ClientLoaded;
				}
				else
				{
					_uiState = UiState.ClientNotFound;
				}
			}
			else
			{
				// Route is /patrimoine
				var result = await SituationService.GetSituationForDefaultClientAsync();

				switch (result.Status)
				{
					case Praxis360_v1.Models.SituationAssuranceVieLoadStatus.ClientLoaded:
						_situation = result.Situation;
						_uiState = UiState.ClientLoaded;
						break;

					case Praxis360_v1.Models.SituationAssuranceVieLoadStatus.NoClientsAvailable:
						_uiState = UiState.NoClientsAvailable;
						break;

					case Praxis360_v1.Models.SituationAssuranceVieLoadStatus.MultipleClientsRequireSelection:
						_selectableClients = await ClientSelectionService.GetSelectableClientsAsync();
						_uiState = UiState.MultipleClientsRequireSelection;
						break;

					default:
						_uiState = UiState.ErrorLoading;
						break;
				}
			}
		}
		catch
		{
			_uiState = UiState.ErrorLoading;
		}
	}

	private void NavigateToClient(Guid clientId)
	{
		NavigationManager.NavigateTo($"/patrimoine/{clientId}");
	}

	private static string FormatMoney(Praxis360_v1.Domain.ValueObjects.Money? money)
	{
		return money != null ? $"{money.Amount:N2} {money.Currency}" : "Non disponible";
	}

	private enum UiState
	{
		Loading,
		ClientLoaded,
		NoClientsAvailable,
		MultipleClientsRequireSelection,
		ClientNotFound,
		ErrorLoading
	}
}
