@page "/clients"
@rendermode InteractiveServer

@inject Praxis360_v1.Application.Interfaces.IClientSelectionService ClientSelectionService

<PageTitle>Clients</PageTitle>

@if (_uiState == UiState.Loading)
{
    <div class="clients-container">
        <div class="clients-header">
            <h1>Clients</h1>
            <p class="clients-subtitle">Chargement de vos clients...</p>
        </div>
    </div>
}
else if (_uiState == UiState.Empty)
{
    <div class="clients-container">
        <div class="clients-header">
            <h1>Clients</h1>
            <p class="clients-subtitle">Gérez et consultez vos clients.</p>
        </div>
        <section class="clients-section">
            <P360Card>
                <div class="empty-state">
                    <p>Vous n'avez pas encore de clients enregistrés.</p>
                    <p>Commencez par <a href="/imports/brio">importer vos données BRIO</a>.</p>
                </div>
            </P360Card>
        </section>
    </div>
}
else if (_uiState == UiState.Error)
{
    <div class="clients-container">
        <div class="clients-header">
            <h1>Clients</h1>
            <p class="clients-subtitle">Une erreur est survenue.</p>
        </div>
        <section class="clients-section">
            <P360Card>
                <div class="empty-state">
                    <p>Impossible de charger la liste des clients. Veuillez réessayer ultérieurement.</p>
                </div>
            </P360Card>
        </section>
    </div>
}
else if (_uiState == UiState.Loaded)
{
    <div class="clients-container">
        <div class="clients-header">
            <h1>Clients</h1>
            <p class="clients-subtitle">Sélectionnez un client pour consulter sa situation.</p>
        </div>
        <section class="clients-section">
            <div class="search-box">
                <label for="client-search" class="visually-hidden">Rechercher un client</label>
                <input type="search"
                       id="client-search"
                       class="search-input"
                       placeholder="Rechercher par nom ou prénom..."
                       @bind="SearchQuery"
                       @bind:event="oninput" />
            </div>
            @if (_filteredClients != null && _filteredClients.Count > 0)
            {
                <div class="clients-list">
                    @foreach (var client in _filteredClients)
                    {
                        <a class="client-card-link" href="@($"/patrimoine/{client.ClientId}")">
                            <P360Card>
                                <div class="client-card">
                                    <div class="client-info">
                                        <span class="client-name">@client.DisplayName</span>
                                        @if (client.DateOfBirth.HasValue)
                                        {
                                            <span class="client-dob">Né(e) le @client.DateOfBirth.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    </div>
                                    <div class="chevron-icon">›</div>
                                </div>
                            </P360Card>
                        </a>
                    }
                </div>
            }
            else
            {
                <P360Card>
                    <div class="empty-state">
                        <p>Aucun client trouvé.</p>
                    </div>
                </P360Card>
            }
        </section>
    </div>
}

@code {
    private UiState _uiState = UiState.Loading;
    private IReadOnlyCollection<Praxis360_v1.Application.Models.SelectableClient>? _allClients;
    private List<Praxis360_v1.Application.Models.SelectableClient>? _filteredClients;
    private string _searchQuery = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _allClients = await ClientSelectionService.GetSelectableClientsAsync();

            if (_allClients == null || _allClients.Count == 0)
            {
                _uiState = UiState.Empty;
            }
            else
            {
                _uiState = UiState.Loaded;
                UpdateFilteredClients();
            }
        }
        catch
        {
            _uiState = UiState.Error;
        }
    }

    private string SearchQuery
    {
        get => _searchQuery;
        set
        {
            _searchQuery = value;
            UpdateFilteredClients();
        }
    }

    private void UpdateFilteredClients()
    {
        if (_allClients == null)
        {
            _filteredClients = null;
            return;
        }

        var query = _searchQuery?.Trim() ?? string.Empty;

        IEnumerable<Praxis360_v1.Application.Models.SelectableClient> filtered;

        if (string.IsNullOrWhiteSpace(query))
        {
            filtered = _allClients;
        }
        else
        {
            filtered = _allClients.Where(c =>
                (c.FirstName?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.LastName?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        _filteredClients = filtered
            .OrderBy(c => c.LastName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(c => c.FirstName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(c => c.ClientId)
            .ToList();
    }

    private enum UiState
    {
        Loading,
        Loaded,
        Empty,
        Error
    }
}
